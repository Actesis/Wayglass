{
  "name": "@wayglass/icons",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --root ../.. packages/icons/test",
    "test:coverage": "vitest run --coverage --root ../.. packages/icons/test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
