{
  "name": "@wayglass/icons",
  "version": "0.0.0",
  "private": true,
  "description": "Generated, direction-aware icons for Wayglass interfaces.",
  "license": "Apache-2.0",
  "author": "Wayglass contributors",
  "homepage": "https://wayglass.hoagsoftworks.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Actesis/Wayglass.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/Actesis/Wayglass/issues"
  },
  "keywords": [
    "wayglass",
    "icons",
    "web-components",
    "operational-ui"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icon": {
      "types": "./dist/icon.d.ts",
      "import": "./dist/icon.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --root ../.. packages/icons/test",
    "test:coverage": "vitest run --coverage --root ../.. packages/icons/test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
