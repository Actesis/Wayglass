{
  "name": "@wayglass/elements",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./boolean-value": {
      "types": "./dist/boolean-value.d.ts",
      "import": "./dist/boolean-value.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "import": "./dist/canvas.js"
    },
    "./elbow": {
      "types": "./dist/elbow.d.ts",
      "import": "./dist/elbow.js"
    },
    "./metric": {
      "types": "./dist/metric.d.ts",
      "import": "./dist/metric.js"
    },
    "./panel": {
      "types": "./dist/panel.d.ts",
      "import": "./dist/panel.js"
    },
    "./rail": {
      "types": "./dist/rail.d.ts",
      "import": "./dist/rail.js"
    },
    "./status-indicator": {
      "types": "./dist/status-indicator.d.ts",
      "import": "./dist/status-indicator.js"
    },
    "./tab": {
      "types": "./dist/tab.d.ts",
      "import": "./dist/tab.js"
    },
    "./tab-list": {
      "types": "./dist/tab-list.d.ts",
      "import": "./dist/tab-list.js"
    },
    "./tab-panel": {
      "types": "./dist/tab-panel.d.ts",
      "import": "./dist/tab-panel.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./theme-provider": {
      "types": "./dist/theme-provider.d.ts",
      "import": "./dist/theme-provider.js"
    },
    "./value-tile": {
      "types": "./dist/value-tile.d.ts",
      "import": "./dist/value-tile.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@wayglass/core": "workspace:*",
    "@wayglass/themes": "workspace:*",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
