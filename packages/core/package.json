{
  "name": "@wayglass/core",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-neutral state models for operational interfaces.",
  "license": "Apache-2.0",
  "author": "Wayglass contributors",
  "homepage": "https://wayglass.hoagsoftworks.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Actesis/Wayglass.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Actesis/Wayglass/issues"
  },
  "keywords": [
    "wayglass",
    "operational-ui",
    "state-model",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0 <27"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --root ../.. packages/core/test",
    "test:coverage": "vitest run --coverage --root ../.. packages/core/test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
