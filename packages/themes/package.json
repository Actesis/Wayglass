{
  "name": "@wayglass/themes",
  "version": "0.1.0",
  "private": true,
  "description": "Wayglass themes and density modes for operational interfaces.",
  "license": "Apache-2.0",
  "author": "Wayglass contributors",
  "homepage": "https://wayglass.hoagsoftworks.com/foundations/tokens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Actesis/Wayglass.git",
    "directory": "packages/themes"
  },
  "bugs": {
    "url": "https://github.com/Actesis/Wayglass/issues"
  },
  "keywords": [
    "wayglass",
    "themes",
    "design-tokens",
    "operational-ui"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <27"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./themes.css": "./dist/themes.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --root ../.. packages/themes/test",
    "test:coverage": "vitest run --coverage --root ../.. packages/themes/test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@wayglass/tokens": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
