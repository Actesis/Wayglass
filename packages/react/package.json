{
  "name": "@wayglass/react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lit/react": "1.0.8"
  },
  "peerDependencies": {
    "@wayglass/elements": "workspace:*",
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@wayglass/elements": "workspace:*",
    "react": "19.2.8",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
