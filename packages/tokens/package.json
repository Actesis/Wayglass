{
  "name": "@wayglass/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Semantic design tokens and generated web artifacts for Wayglass.",
  "license": "Apache-2.0",
  "author": "Wayglass contributors",
  "homepage": "https://wayglass.hoagsoftworks.com/foundations/tokens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Actesis/Wayglass.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/Actesis/Wayglass/issues"
  },
  "keywords": [
    "wayglass",
    "design-tokens",
    "css-custom-properties",
    "operational-ui"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0 <27"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --root ../.. packages/tokens/test",
    "test:coverage": "vitest run --coverage --root ../.. packages/tokens/test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
