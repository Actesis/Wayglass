{
  "name": "wayglass",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "A design language for operational awareness.",
  "homepage": "https://wayglass.hoagsoftworks.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Actesis/Wayglass.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "docs:build": "pnpm --filter @wayglass/docs build",
    "docs:dev": "pnpm --filter @wayglass/docs dev",
    "example:react": "pnpm --filter @wayglass/example-react dev",
    "example:smart-home": "pnpm --filter @wayglass/example-smart-home dev",
    "example:vanilla": "pnpm --filter @wayglass/example-vanilla dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "storybook": "pnpm --filter @wayglass/storybook dev",
    "storybook:build": "pnpm --filter @wayglass/storybook build",
    "test": "turbo run test",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium firefox webkit",
    "test:coverage": "turbo run test:coverage",
    "tokens:build": "pnpm --filter @wayglass/tokens build",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-wc": "3.1.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
