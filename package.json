{
  "name": "wayglass",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "A design language for operational awareness.",
  "homepage": "https://wayglass.hoagsoftworks.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Actesis/Wayglass.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm token-tooling:generate:web && turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm icon-tooling:check && pnpm icon-tooling:core:check && pnpm token-tooling:check && pnpm token-tooling:core:check && pnpm release-candidate:core:check && pnpm site-composer:core:check && pnpm cloudflare-delivery:core:check && pnpm experiment:phase5c:check && pnpm typecheck && pnpm test",
    "cloudflare-delivery:core:check": "pnpm cloudflare-delivery:core:typecheck && pnpm cloudflare-delivery:core:test",
    "cloudflare-delivery:core:test": "vitest run --root tooling/cloudflare-delivery --config vitest.config.ts",
    "cloudflare-delivery:core:typecheck": "tsc --noEmit -p tooling/cloudflare-delivery/tsconfig.json",
    "docs:build": "pnpm --filter @wayglass/docs build",
    "docs:dev": "pnpm --filter @wayglass/docs dev",
    "example:agent-supervision": "pnpm --filter @wayglass/example-agent-supervision dev",
    "example:react": "pnpm --filter @wayglass/example-react dev",
    "example:operations-console": "pnpm --filter @wayglass/example-operations-console dev",
    "example:smart-home": "pnpm --filter @wayglass/example-smart-home dev",
    "example:vanilla": "pnpm --filter @wayglass/example-vanilla dev",
    "experiment:phase5c:check": "pnpm experiment:phase5c:typecheck && pnpm experiment:phase5c:test",
    "experiment:phase5c:test": "vitest run --root experiments/phase-5c-rich-visualization --config vitest.config.ts",
    "experiment:phase5c:typecheck": "tsc --noEmit -p experiments/phase-5c-rich-visualization/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icon-tooling:check": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/icon-pipeline/src/cli.ts check",
    "icon-tooling:core:check": "pnpm icon-tooling:core:typecheck && pnpm icon-tooling:core:test",
    "icon-tooling:core:test": "vitest run --root tooling/icon-pipeline --config vitest.config.ts",
    "icon-tooling:core:typecheck": "tsc --noEmit -p tooling/icon-pipeline/tsconfig.json",
    "icon-tooling:generate": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/icon-pipeline/src/cli.ts generate",
    "lint": "eslint .",
    "release-candidate:core:check": "pnpm release-candidate:core:typecheck && pnpm release-candidate:core:test",
    "release-candidate:core:test": "vitest run --root tooling/release-candidate --config vitest.config.ts",
    "release-candidate:core:typecheck": "tsc --noEmit -p tooling/release-candidate/tsconfig.json",
    "release-candidate:build": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/release-candidate/src/cli.ts build",
    "release-candidate:build-publication": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/release-candidate/src/cli.ts build-publication",
    "release-candidate:capture-advisory": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/release-candidate/src/cli.ts capture-advisory",
    "release-candidate:check": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/release-candidate/src/cli.ts check",
    "release-candidate:integrated": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/release-candidate/src/cli.ts integrated",
    "release-candidate:probe:browsers": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/release-candidate/src/cli.ts probe-browsers",
    "release-candidate:probe:react": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/release-candidate/src/cli.ts probe-react",
    "release-candidate:probe:vanilla": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/release-candidate/src/cli.ts probe-vanilla",
    "release-candidate:provision-consumers": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/release-candidate/src/cli.ts provision-consumers",
    "release-candidate:publication-plan": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/release-candidate/src/cli.ts publication-plan",
    "release-candidate:rehearse": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/release-candidate/src/cli.ts rehearse",
    "release-candidate:verify": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/release-candidate/src/cli.ts verify",
    "release-candidate:verify-publication": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/release-candidate/src/cli.ts verify-publication",
    "release-candidate:verify-integrated": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/release-candidate/src/cli.ts verify-integrated",
    "site-composer:core:check": "pnpm site-composer:core:typecheck && pnpm site-composer:core:test",
    "site-composer:core:test": "vitest run --root tooling/site-composer --config vitest.config.ts",
    "site-composer:core:typecheck": "tsc --noEmit -p tooling/site-composer/tsconfig.json",
    "site:build": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/site-composer/src/cli.ts build",
    "site:browser-proof": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/site-composer/src/browser-proof.ts",
    "site:browser:edge:check": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/cloudflare-delivery/src/browser-cli.ts",
    "site:check-responses": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/site-composer/src/cli.ts check-responses",
    "site:compose": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/site-composer/src/cli.ts compose",
    "site:edge:check": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/cloudflare-delivery/src/edge-cli.ts",
    "site:serve": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/site-composer/src/cli.ts serve",
    "site:verify": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/site-composer/src/cli.ts verify",
    "site:wrangler:check": "node --disable-warning=ExperimentalWarning --experimental-strip-types tooling/cloudflare-delivery/src/cli.ts",
    "storybook": "pnpm --filter @wayglass/storybook dev",
    "storybook:build": "pnpm --filter @wayglass/storybook build",
    "test": "turbo run test",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium firefox webkit",
    "test:coverage": "turbo run test:coverage",
    "themes:build": "pnpm token-tooling:generate:web && pnpm --filter @wayglass/themes build",
    "tokens:build": "pnpm token-tooling:generate:web && pnpm --filter @wayglass/tokens build",
    "token-tooling:core:check": "pnpm token-tooling:core:typecheck && pnpm token-tooling:core:test",
    "token-tooling:core:test": "vitest run --root tooling/token-interchange --config vitest.config.ts",
    "token-tooling:core:typecheck": "tsc --noEmit -p tooling/token-interchange/tsconfig.json",
    "token-tooling:check": "node --experimental-strip-types tooling/token-interchange/src/cli.ts check",
    "token-tooling:generate:web": "node --experimental-strip-types tooling/token-interchange/src/cli.ts generate:web",
    "token-tooling:fingerprint": "vitest run --root tooling/token-interchange --config vitest.validation.config.ts --reporter=verbose",
    "token-tooling:generate:exchange": "node --experimental-strip-types tooling/token-interchange/src/cli.ts generate:exchange",
    "token-tooling:measure": "node --experimental-strip-types tooling/token-interchange/src/cli.ts measure",
    "token-tooling:verify": "node --experimental-strip-types tooling/token-interchange/src/cli.ts verify",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-wc": "3.1.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "rolldown": "1.1.5",
    "turbo": "2.10.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.128.0"
  }
}
